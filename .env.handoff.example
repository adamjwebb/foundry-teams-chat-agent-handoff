# Copy to .env.handoff at the repository root; that file is ignored by git.
# Replace every synthetic identity with your own test-tenant values.
HANDOFF_TENANT_ID=11111111-1111-4111-8111-111111111111
HANDOFF_HUMAN_UPN=helpdesk@example.test

# Optional broker: set true only after the documented admin grants/publication.
HANDOFF_BROKER_ENABLED=false
HANDOFF_HUMAN_OBJECT_ID=33333333-3333-4333-8333-333333333333
# This is the Teams catalog app ID, not BOT_ID or the app manifest ID.
HANDOFF_TEAMS_CATALOG_APP_ID=44444444-4444-4444-8444-444444444444
